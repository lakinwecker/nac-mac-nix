#!/usr/bin/env bash
# Regenerate gh-dash/repos.nix — the per-context repo lists that gh-dash's
# notification sections filter on.
#
# gh-dash has no org: filter for notifications (only repo:owner/name), and it
# issues one serial REST call per repo, so the lists are kept to repos you're
# actually active in rather than every repo in the org.
#
# Usage: gh-dash-repos [--repo-root DIR] [--months N] [--max N]
set -euo pipefail

ROOT="${GH_DASH_REPO_ROOT:-$HOME/personal-repos/nac-mac-nix}"
MONTHS=12
MAX=12

while [ $# -gt 0 ]; do
  case "$1" in
    --repo-root) ROOT="$2"; shift 2 ;;
    --months)    MONTHS="$2"; shift 2 ;;
    --max)       MAX="$2"; shift 2 ;;
    -h|--help)   sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# context:org[,org...] — the one place the mapping is declared.
CONTEXTS=(
  "SA:structured-abstraction"
  "Narrative:narrative-io"
  "BigGeo:BigGeo-GIV"
  "lichess:lichess-org,Lichess4545"
)

OUT="$ROOT/gh-dash/repos.nix"
mkdir -p "$(dirname "$OUT")"
SINCE=$(date -d "$MONTHS months ago" +%Y-%m-%d)

# Repos that actually produced notifications, most recent first. This is the
# best proxy for "repos gh-dash should watch": it's the same feed it reads.
notified=$(mktemp)
trap 'rm -f "$notified"' EXIT
for page in 1 2 3; do
  gh api "notifications?all=true&per_page=100&page=$page" \
    --jq '.[].repository.full_name' || true
done > "$notified"

{
  echo "# Generated by bin/scripts/gh-dash-repos — do not edit by hand."
  echo "# Repos per context that gh-dash watches for notifications."
  echo "# Regenerate: gh-dash-repos   (then rebuild)"
  echo "# Last generated: $(date +%Y-%m-%d), activity since $SINCE."
  echo "{"
  for entry in "${CONTEXTS[@]}"; do
    ctx="${entry%%:*}"
    orgs="${entry#*:}"

    # Union of two signals: repos that notified you, and repos where you
    # authored or were assigned an issue/PR in the window.
    repos=$(
      {
        IFS=,
        for org in $orgs; do
          grep -i "^$org/" "$notified" || true
          gh search issues --owner "$org" --involves=@me \
            --updated ">=$SINCE" --limit 100 \
            --json repository --jq '.[].repository.nameWithOwner' 2>/dev/null || true
        done
      } | awk '!seen[$0]++' | head -n "$MAX"
    )

    # An empty list would make gh-dash drop the repo filter and show *every*
    # notification in that tab, so fall back to the org's live repos.
    if [ -z "$repos" ]; then
      repos=$(
        IFS=,
        for org in $orgs; do
          gh api "orgs/$org/repos?per_page=100&sort=pushed" \
            --jq '.[] | select(.archived | not) | .full_name' 2>/dev/null || true
        done | head -n "$MAX"
      )
    fi

    echo "  $ctx = ["
    while read -r repo; do
      [ -n "$repo" ] && echo "    \"$repo\""
    done <<< "$repos"
    echo "  ];"
  done
  echo "}"
} > "$OUT"

echo "wrote $OUT"
grep -c '"' "$OUT" | xargs echo "repos:"
