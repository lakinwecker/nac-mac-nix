#!/usr/bin/env bash
# Toggle light/dark across ghostty, nvim, hyprland, zellij, GTK apps, Firefox.
# Source of truth: dconf color-scheme. dconf, not gsettings — Hyprland's exec
# environment doesn't reliably have gsettings-desktop-schemas in XDG_DATA_DIRS.
set -euo pipefail

# Hyprland's exec gives this a minimal PATH.
export PATH="/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/$USER/bin:${PATH:-}"

scheme_key="/org/gnome/desktop/interface/color-scheme"
theme_key="/org/gnome/desktop/interface/gtk-theme"

current=$(dconf read "$scheme_key" 2>/dev/null || true)

if [ "$current" = "'prefer-dark'" ]; then
  mode="light"
  gtk_scheme="'prefer-light'"
  gtk_theme="'Adwaita'"
  hypr_active="0xff797593"
  hypr_inactive="0xffcecacd"
  nvim_bg="light"
  nvim_colors="tokyonight-day"
else
  mode="dark"
  gtk_scheme="'prefer-dark'"
  gtk_theme="'Adwaita-dark'"
  hypr_active="0xffd7827e"
  hypr_inactive="0xff286983"
  nvim_bg="dark"
  nvim_colors="tokyonight-storm"
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_dir"
printf '%s\n' "$mode" > "$state_dir/theme-mode"

# Drives Firefox + ghostty auto-follow via xdg-desktop-portal.
dconf write "$scheme_key" "$gtk_scheme"
dconf write "$theme_key" "$gtk_theme"

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl keyword general:col.active_border "$hypr_active" >/dev/null
  hyprctl keyword general:col.inactive_border "$hypr_inactive" >/dev/null
fi

# Push to every running nvim via its auto-socket.
if command -v nvim >/dev/null 2>&1; then
  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  shopt -s nullglob
  for sock in "$runtime_dir"/nvim.*.[0-9]*; do
    [ -S "$sock" ] || continue
    nvim --server "$sock" --remote-expr \
      "execute('set background=$nvim_bg | silent! colorscheme $nvim_colors')" \
      >/dev/null 2>&1 || true
  done
  shopt -u nullglob
fi

# ghostty needs no action: its `theme = light:X,dark:Y` follows the portal.

# Covers zellij sessions whose terminal doesn't report mode 2031.
if command -v zellij >/dev/null 2>&1; then
  sessions=$(zellij list-sessions --no-formatting 2>/dev/null | grep -v 'EXITED' | awk '{print $1}' || true)
  for session in $sessions; do
    zellij --session "$session" action "set-$mode-theme" >/dev/null 2>&1 || true
  done
fi

# Copy rather than symlink, mirroring how the activation script seeds it.
wayle_src="/etc/wayle/config-$mode.toml"
wayle_dst="$HOME/.config/wayle/config.toml"
if [ -f "$wayle_src" ] && command -v wayle >/dev/null 2>&1; then
  install -m 0644 "$wayle_src" "$wayle_dst"
  wayle panel restart >/dev/null 2>&1 || true
fi

# Substring swap preserves any `-daltonized`/`-ansi` suffix.
claude_settings="$HOME/.claude/settings.json"
if command -v jq >/dev/null 2>&1 && [ -f "$claude_settings" ]; then
  current_theme=$(jq -r '.theme // "dark"' "$claude_settings")
  if [ "$mode" = "light" ]; then
    new_theme="${current_theme/dark/light}"
  else
    new_theme="${current_theme/light/dark}"
  fi
  tmp=$(mktemp)
  if jq --arg t "$new_theme" '.theme = $t' "$claude_settings" > "$tmp"; then
    mv "$tmp" "$claude_settings"
  else
    rm -f "$tmp"
  fi
fi

# Not picked up live; set Signal's Appearance to "Match system" for that.
signal_settings="$HOME/.config/Signal/ephemeral.json"
if command -v jq >/dev/null 2>&1 && [ -f "$signal_settings" ]; then
  tmp=$(mktemp)
  if jq --arg t "$mode" '."theme-setting" = $t' "$signal_settings" > "$tmp"; then
    mv "$tmp" "$signal_settings"
  else
    rm -f "$tmp"
  fi
fi

if command -v notify-send >/dev/null 2>&1; then
  notify-send -t 1500 "Theme: $mode"
fi
