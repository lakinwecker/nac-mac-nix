#!/usr/bin/env bash
# LazyPi (https://lazypi.org), the installer for the Pi coding agent.
set -euo pipefail

# Not reliably inherited (devenv shells drop it); npm would target the
# read-only nodejs store path.
NPM_CONFIG_PREFIX="${NPM_CONFIG_PREFIX:-$HOME/.npm-global}"
export NPM_CONFIG_PREFIX
mkdir -p "$NPM_CONFIG_PREFIX/bin"

# Drop our own dir from PATH: LazyPi probes with a bare `which pi`, which would
# find the `pi` wrapper sitting next to this script.
SELF_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF -- "$SELF_DIR" | paste -sd: - || true)"
export PATH

exec npx -y @robzolkos/lazypi "$@"
